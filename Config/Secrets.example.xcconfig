// Copy this file to Config/Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is git-ignored. Never put a Spotify client *secret* here;
// the app only needs the client ID (the App Remote flow has no secret).

// Your Apple Developer Team ID (Xcode > Settings > Accounts > your team).
DEVELOPMENT_TEAM = ABCDE12345

// Something unique to you, e.g. com.yourname.norwegian4x4
APP_BUNDLE_ID = com.yourname.norwegian4x4

// From https://developer.spotify.com/dashboard (leave as-is to disable Spotify).
SPOTIFY_CLIENT_ID = 0123456789abcdef0123456789abcdef
